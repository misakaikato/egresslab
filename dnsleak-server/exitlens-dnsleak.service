[Unit]
Description=ExitLens DNS leak observer
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/exitlens-dnsleak/server.mjs
WorkingDirectory=/opt/exitlens-dnsleak
Environment=DNSLEAK_ZONE=leak.exitlens.misakamikoto.top
Environment=HTTP_PORT=8090
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
