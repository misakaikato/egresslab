# 可选:proxycheck.io 免费 key(1000 次/天),配置后 /api/ip 增加 VPN/住宅代理识别精度
PROXYCHECK_API_KEY=

# 可选:AbuseIPDB 免费 key(1000 次/天),配置后 abuse_score 来自真实举报数据
ABUSEIPDB_API_KEY=

# 蜜罐上报密钥:配置后 POST /api/honeypot 需携带相同 X-Sensor-Key 请求头
HONEYPOT_KEY=

# 可选:REST API(/api/v1/*)鉴权,配置后需携带 x-api-key 请求头;不配置则不鉴权
EGRESSLAB_API_KEY=

# ---- 本地库(可选,scripts/update-local-dbs.sh 使用) ----
# MaxMind GeoLite2 免费账号(https://www.maxmind.com 注册)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# IPInfo 免费数据库 token(https://ipinfo.io 注册)
IPINFO_TOKEN=
# IP2Location LITE 下载 token(https://www.ip2location.com 注册)
IP2LOCATION_TOKEN=

# IP2Location.io 在线 API key(含 is_proxy/usage_type)
IP2LOCATION_IO_KEY=
